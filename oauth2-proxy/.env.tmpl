{{- defineDatasource "deployment" "env:///DEPLOYMENT?type=application/json" -}}
{{- $deployment := ds "deployment" -}}
{{- printf "OAUTH2_PROXY_CLIENT_ID={{ %s }}\n" $deployment.service.runtime.credentials.oidc_client_id -}}
{{- printf "OAUTH2_PROXY_CLIENT_SECRET={{ %s }}\n" $deployment.service.runtime.credentials.oidc_client_secret -}}
{{- printf "OAUTH2_PROXY_COOKIE_SECRET={{ %s }}\n" $deployment.service.runtime.credentials.cookie_secret -}}
