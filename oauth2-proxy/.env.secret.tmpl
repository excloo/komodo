{{- defineDatasource "deployment" "env:///DEPLOYMENT?type=application/json" -}}
{{- $deployment := ds "deployment" -}}
{{- printf "OAUTH2_PROXY_CLIENT_ID={{ op://%s/%s/oidc_client_id }}\n" $deployment.vaults.services $deployment.item -}}
{{- printf "OAUTH2_PROXY_CLIENT_SECRET={{ op://%s/%s/oidc_client_secret }}\n" $deployment.vaults.services $deployment.item -}}
{{- printf "OAUTH2_PROXY_COOKIE_SECRET={{ op://%s/%s/cookie_secret }}\n" $deployment.vaults.services $deployment.item -}}
