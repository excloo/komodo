{{- defineDatasource "deployment" "env:///DEPLOYMENT?type=application/json" -}}
{{- $deployment := ds "deployment" -}}
{{- printf "CF_DNS_API_TOKEN={{ op://%s/%s/cloudflare_acme_token }}\n" $deployment.vaults.servers $deployment.target_config.item -}}
{{- printf "MONITORING_PASSWORD_HASH={{ op://%s/%s/monitoring_password_hash }}\n" $deployment.vaults.services $deployment.item -}}
