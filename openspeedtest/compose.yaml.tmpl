{{- defineDatasource "deployment" "env:///DEPLOYMENT?type=application/json" -}}
{{- $deployment := ds "deployment" -}}
services:
  openspeedtest:
    environment:
      CHANGE_CONTAINER_PORTS: "True"
      HTTP_PORT: {{ $deployment.service.routing.default.backend.port }}
    image: openspeedtest/latest:v2.0.6
    {{- $labels := index $deployment.routing_labels "openspeedtest" }}
    {{- if $labels }}
    labels:
      {{- $yaml := $labels | toYAML | strings.TrimSpace }}
      {{- printf "\n%s" ($yaml | strings.Indent 6) }}
    {{- end }}
    restart: unless-stopped
