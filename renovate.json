{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "depTypeTemplate": "docker",
      "managerFilePatterns": ["/(^|/).+\\.tmpl$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)\\s*image:\\s*(?<depName>[^\\s:@]+(?:/[^\\s:@]+)*):(?<currentValue>[^\\s@#]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "automerge": true,
      "description": "Automerge passing patch and pin updates",
      "matchUpdateTypes": ["patch", "pin"]
    },
    {
      "description": "Group Docker image updates",
      "groupName": "Docker images",
      "matchManagers": ["docker", "docker-compose"]
    },
    {
      "description": "Group GitHub Actions updates",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Group mise tool updates",
      "groupName": "mise tools",
      "matchManagers": ["mise"]
    },
    {
      "description": "Group Prek hook updates",
      "groupName": "Prek hooks",
      "matchManagers": ["pre-commit"]
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
