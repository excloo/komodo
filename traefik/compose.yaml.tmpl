{{- defineDatasource "deployment" "env:///DEPLOYMENT?type=application/json" -}}
{{- $deployment := ds "deployment" -}}
services:
  traefik:
    command:
      - --api.dashboard=true
      - --certificatesresolvers.cloudflare.acme.dnschallenge.propagation.delayBeforeChecks=10s
      - --certificatesresolvers.cloudflare.acme.dnschallenge.propagation.requireAllRNS=false
      - --certificatesresolvers.cloudflare.acme.dnschallenge.provider=cloudflare
      - --certificatesresolvers.cloudflare.acme.dnschallenge.resolvers=1.1.1.1:53,8.8.8.8:53
      - --certificatesresolvers.cloudflare.acme.email={{ $deployment.defaults.organisation.email }}
      - --certificatesresolvers.cloudflare.acme.storage=/letsencrypt/acme.json
      - --entrypoints.metrics.address={{ $deployment.server.runtime.addresses.tailscale_ipv4 }}:28083
      - --entrypoints.web.address=:80
      - --entrypoints.webinternal.address={{ $deployment.server.runtime.addresses.tailscale_ipv4 }}:28000
      - --entrypoints.websecure.address=:443
      - --entrypoints.websecure.http.middlewares=autocompress@docker
      - --entrypoints.websecure.http.tls.certResolver=cloudflare
      - --entrypoints.websecure.http.tls.domains[0].main={{ $deployment.server.hosts.external }}
      - --entrypoints.websecure.http.tls.domains[0].sans=*.{{ $deployment.server.hosts.external }}
      - --entrypoints.websecure.http.tls.domains[1].main={{ $deployment.server.hosts.internal }}
      - --entrypoints.websecure.http.tls.domains[1].sans=*.{{ $deployment.server.hosts.internal }}
      - --metrics.prometheus.addEntryPointsLabels=true
      - --metrics.prometheus.addRoutersLabels=true
      - --metrics.prometheus.addServicesLabels=true
      - --metrics.prometheus.entryPoint=metrics
      - --metrics.prometheus=true
      - --providers.docker.defaultRule=Host(`{{ print "{{" }} index .Labels "com.docker.compose.project" | trimPrefix "ix-"{{ print "}}" }}.{{ $deployment.server.hosts.internal }}`)
      - --providers.docker.exposedbydefault=false
      - --providers.docker=true
      - --serverstransport.insecureskipverify=true
    environment:
      CF_DNS_API_TOKEN: ${CF_DNS_API_TOKEN}
    extra_hosts:
      - host.docker.internal:127.0.0.1
    image: traefik:v3.7.10
    {{- $labels := index $deployment.routing_labels "traefik" }}
    {{- if $labels }}
    labels:
      {{- $yaml := $labels | toYAML | strings.TrimSpace }}
      {{- printf "\n%s" ($yaml | strings.Indent 6) }}
    {{- end }}
    network_mode: host
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - letsencrypt:/letsencrypt
volumes:
  letsencrypt:
