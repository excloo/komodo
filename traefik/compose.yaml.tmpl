{{- defineDatasource "deployment" "env:///DEPLOYMENT?type=application/json" -}}
{{- $deployment := ds "deployment" -}}
services:
  traefik:
    command:
      - --api.dashboard=true
      - --certificatesresolvers.cloudflare.acme.dnschallenge.propagation.delayBeforeChecks=10s
      - --certificatesresolvers.cloudflare.acme.dnschallenge.propagation.requireAllRNS=false
      - --certificatesresolvers.cloudflare.acme.dnschallenge.provider=cloudflare
      - --certificatesresolvers.cloudflare.acme.dnschallenge.resolvers=1.1.1.1:53,8.8.8.8:53
      - --certificatesresolvers.cloudflare.acme.email={{ $deployment.target_config.email }}
      - --certificatesresolvers.cloudflare.acme.storage=/letsencrypt/acme.json
      - --entrypoints.traefik.address=:8082
      - --entrypoints.web.address=:80
      - --entrypoints.webinternal.address=:8000
      - --entrypoints.websecure.address=:443
      - --entrypoints.websecure.http.middlewares=autocompress@docker
      - --entrypoints.websecure.http.tls.certResolver=cloudflare
      - --entrypoints.websecure.http.tls.domains[0].main={{ $deployment.target_config.hosts.external }}
      - --entrypoints.websecure.http.tls.domains[0].sans=*.{{ $deployment.target_config.hosts.external }}
      - --entrypoints.websecure.http.tls.domains[1].main={{ $deployment.target_config.hosts.internal }}
      - --entrypoints.websecure.http.tls.domains[1].sans=*.{{ $deployment.target_config.hosts.internal }}
      - --providers.docker.defaultRule=Host(`{{ print "{{" }} index .Labels "com.docker.compose.project" | trimPrefix "ix-"{{ print "}}" }}.{{ $deployment.target_config.hosts.internal }}`)
      - --providers.docker.exposedbydefault=false
      - --providers.docker=true
      - --serverstransport.insecureskipverify=true
    environment:
      CF_DNS_API_TOKEN: ${CF_DNS_API_TOKEN}
    extra_hosts:
      - host.docker.internal:127.0.0.1
    image: traefik:v3.7.10
    {{- if or $deployment.labels $deployment.custom.proxy_routes }}
    labels:
      {{- if $deployment.labels }}
      {{- $labels := $deployment.labels | toYAML | strings.TrimSpace }}
      {{- printf "\n%s" ($labels | strings.Indent 6) }}
      {{- end }}
      {{- range $name, $route := $deployment.custom.proxy_routes }}
      traefik.http.routers.{{ $name }}.entryPoints: websecure
      traefik.http.routers.{{ $name }}.rule: 'Host(`{{ $route.host }}`)'
        {{- if $route.redirect_to }}
      traefik.http.middlewares.{{ $name }}.redirectRegex.permanent: "true"
      traefik.http.middlewares.{{ $name }}.redirectRegex.regex: '^https?://{{ $route.host | strings.ReplaceAll "." "\\." }}'
      traefik.http.middlewares.{{ $name }}.redirectRegex.replacement: {{ $route.redirect_to }}
      traefik.http.routers.{{ $name }}.middlewares: {{ $name }}
      traefik.http.routers.{{ $name }}.service: noop@internal
        {{- else }}
      traefik.http.routers.{{ $name }}.service: {{ $name }}
      traefik.http.services.{{ $name }}.loadbalancer.server.url: {{ $route.backend_url }}
        {{- end }}
      {{- end }}
    {{- end }}
    network_mode: host
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - letsencrypt:/letsencrypt
volumes:
  letsencrypt:
